<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topActions"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="打开功能菜单"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            android:tooltipText="功能菜单" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/surface_container"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:endIconDrawable="@drawable/ic_search"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/notesButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="我的笔记"
            android:padding="12dp"
            android:src="@drawable/ic_document"
            app:tint="@color/home_header_action_tint"
            app:tintMode="src_in"
            android:tooltipText="我的笔记" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/primaryAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="页面操作"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            app:tint="@color/home_header_action_tint"
            app:tintMode="src_in" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickAccessSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="快捷功能"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/on_surface_variant" />

        <HorizontalScrollView
            android:id="@+id/quickAccessScroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/quickAccessGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickPrivateChat"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="打开私聊，选择好友后进入一对一聊天"
                    android:text="私聊"
                    android:textColor="@color/on_surface"
                    android:tooltipText="选择好友并进入私聊"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipIcon="@drawable/ic_chat"
                    app:chipIconTint="@color/primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickGroupChat"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="打开群聊，选择群聊或聊天室后进入交流"
                    android:text="群聊"
                    android:textColor="@color/on_surface"
                    android:tooltipText="选择群聊或聊天室"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipIcon="@drawable/ic_users"
                    app:chipIconTint="@color/primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickRedPackets"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="打开红包，查看、发送或领取红包"
                    android:text="红包"
                    android:textColor="@color/on_surface"
                    android:tooltipText="查看、发送或领取红包"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipIcon="@drawable/ic_wallet"
                    app:chipIconTint="@color/primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickForum"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="打开论坛，浏览板块、帖子和评论"
                    android:text="论坛"
                    android:textColor="@color/on_surface"
                    android:tooltipText="浏览论坛板块和帖子"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipIcon="@drawable/ic_forum"
                    app:chipIconTint="@color/primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickShortVideos"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="打开短视频，浏览可循环观看的视频内容"
                    android:text="短视频"
                    android:textColor="@color/on_surface"
                    android:tooltipText="浏览短视频"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipIcon="@drawable/ic_video"
                    app:chipIconTint="@color/primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickShop"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="打开商城，浏览可购买的商品和权益"
                    android:text="商城"
                    android:textColor="@color/on_surface"
                    android:tooltipText="浏览商城商品和权益"
                    app:chipBackgroundColor="@color/surface_container"
                    app:chipIcon="@drawable/ic_apps"
                    app:chipIconTint="@color/primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/outline_variant"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_dock_height"
        android:minHeight="@dimen/bottom_dock_height"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:background="@color/glass_surface_strong"
        android:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_navigation_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.Yiyunying.BottomNavigation.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.Yiyunying.BottomNavigation.Inactive"
        app:itemTextColor="@color/bottom_navigation_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/user_bottom_navigation" />
</LinearLayout>
