        <LinearLayout
            android:id="@+id/inlineAlbumPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inlineAlbumBack"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="返回功能列表"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_back"
                    app:iconPadding="0dp" />

                <TextView
                    android:id="@+id/inlineAlbumTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="最近照片和视频"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inlineAlbumOpen"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="完整相册" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inlineAlbumList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingVertical="4dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/inlineAlbumEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="正在读取最近照片和视频"
                    android:textColor="@color/on_surface_variant" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/inlineAlbumOriginal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="原图/原视频" />

                <TextView
                    android:id="@+id/inlineAlbumCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="未选择"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inlineAlbumSend"
                    style="@style/Widget.Yiyunying.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:enabled="false"
                    android:text="添加" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/emojiPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Emoji" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" /><com.google.android.material.button.MaterialButton android:id="@+id/showStickersButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="表情包" /></LinearLayout>
                <GridLayout android:id="@+id/emojiGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="8" android:paddingTop="4dp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/stickerPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="我的表情包"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/on_surface_variant" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/showEmojiButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Emoji" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/openStickersButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="刷新表情包" />
                <com.google.android.material.button.MaterialButton android:id="@+id/uploadStickerButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="上传新表情" />
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
                <GridLayout android:id="@+id/stickerGrid" android:layout_width="wrap_content" android:layout_height="match_parent" android:columnCount="4" android:paddingTop="4dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
