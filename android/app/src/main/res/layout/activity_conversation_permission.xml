<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:minHeight="56dp"
        android:title="@string/conversation_permission_title"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:titleTextColor="?attr/colorOnSurface" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/profile_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/profile"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/profile_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/open_profile"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/conversation_section"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_settings_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/pinned_switch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/pin_conversation" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/bottomed_switch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/bottom_conversation" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/muted_switch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/mute_conversation" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hidden_switch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/hide_conversation" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friend_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/friend_permission_section"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_settings_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/friend_remark">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/remark_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="100"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/relationship_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/relationship_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="60"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/auto_relationship_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/generate_relationship_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/friend_clue_note"
                        app:helperText="@string/friend_clue_auto_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clue_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:longClickable="false"
                            android:maxLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/special_care_switch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/special_care" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/only_chat_switch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/only_chat" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/hide_my_dynamic_switch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/hide_my_dynamic" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/hide_their_dynamic_switch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/hide_their_dynamic" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/blacklist_switch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/add_to_blacklist" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recommend_contact_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/recommend_this_contact" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_friend_button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/save_friend_permissions" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/chat_background_section"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_settings_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/background_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/choose_background_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/choose_background" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reset_background_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/use_global_background" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/system_default_background_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/use_system_default_background" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
