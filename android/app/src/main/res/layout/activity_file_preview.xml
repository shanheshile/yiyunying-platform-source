<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true" />

    <xyz.jjmxg.yiyunying.ui.common.ZoomableMediaFrame
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface_container">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@color/surface_container"
            android:contentDescription="图片预览"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/videoPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:visibility="gone">

            <VideoView
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/videoPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF000000"
                android:contentDescription="视频封面"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/videoBuffer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/videoCenterPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_media_play"
                android:contentDescription="播放视频"
                android:padding="19dp"
                android:src="@drawable/ic_play"
                app:tint="#FFFFFFFF" />

            <LinearLayout
                android:id="@+id/videoControls"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:background="#B3000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/videoPlay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="播放或暂停"
                    android:padding="13dp"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFFFF" />

                <SeekBar
                    android:id="@+id/videoSeek"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/videoTime"
                    android:layout_width="92dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="00:00 / 00:00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoSpeed"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="54dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="1.0x"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/videoFullscreen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="全屏"
                    android:padding="13dp"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/audioPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_container_high"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="音频文件"
                    android:src="@drawable/ic_file"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/audioTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <SeekBar
                    android:id="@+id/audioSeek"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/audioTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00 / 00:00"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audioPlay"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="暂停播放" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/unsupportedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_container_high"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/unsupported"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="该文件不能在应用内直接预览，可使用右上角下载后查看。"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/on_surface_variant" />
        </com.google.android.material.card.MaterialCardView>
    </xyz.jjmxg.yiyunying.ui.common.ZoomableMediaFrame>
</LinearLayout>