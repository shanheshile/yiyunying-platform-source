<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Yiyunying.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="materialCardViewStyle">@style/Widget.Yiyunying.Card</item>
        <item name="materialButtonStyle">@style/Widget.Yiyunying.Button</item>
    </style>

    <style name="Theme.Yiyunying" parent="Theme.Yiyunying.Base" />

    <style name="ThemeOverlay.Yiyunying.Accent" parent="ThemeOverlay.Yiyunying.Accent.Blue" />

    <style name="ThemeOverlay.Yiyunying.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryContainer">@color/accent_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_blue_container</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryContainer">@color/accent_blue_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_blue_container</item>
    </style>

    <style name="ThemeOverlay.Yiyunying.Accent.Teal" parent="">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryContainer">@color/accent_teal_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_teal_container</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSecondaryContainer">@color/accent_teal_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_teal_container</item>
    </style>

    <style name="ThemeOverlay.Yiyunying.Accent.Rose" parent="">
        <item name="colorPrimary">@color/accent_rose</item>
        <item name="colorPrimaryContainer">@color/accent_rose_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_rose_container</item>
        <item name="colorSecondary">@color/accent_rose</item>
        <item name="colorSecondaryContainer">@color/accent_rose_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_rose_container</item>
    </style>

    <style name="ThemeOverlay.Yiyunying.Font" parent="" />

    <style name="ThemeOverlay.Yiyunying.Font.System">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="ThemeOverlay.Yiyunying.Font.Sans">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="ThemeOverlay.Yiyunying.Font.Serif">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
    </style>

    <style name="ThemeOverlay.Yiyunying.Font.Monospace">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
    </style>

    <style name="Widget.Yiyunying.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="strokeColor">@color/glass_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Yiyunying.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Yiyunying.ChatFunctionIcon" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_chat_function_icon</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="TextAppearance.Yiyunying.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Yiyunying.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
