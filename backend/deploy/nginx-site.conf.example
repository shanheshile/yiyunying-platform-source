server {
    listen 80;
    server_name appht.jjmxg.xyz;

    # 必须指向 public，不能指向 yiyunying-backend 根目录。
    root /www/wwwroot/appht.jjmxg.xyz/yiyunying-backend/public;
    index index.php;
    charset utf-8;
    # 必须大于 PHP post_max_size 和应用层单文件上限。multipart/form-data 还会产生额外开销。
    # 这里为 1 GiB 原视频预留约 76 MiB 请求体余量。
    client_max_body_size 1100m;
    client_body_timeout 900s;

    location / {
        # __route preserves the original API path even when a server panel
        # rewrites PHP REQUEST_URI to /index.php or /.
        try_files $uri $uri/ /index.php?__route=$uri&$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_read_timeout 900s;
        fastcgi_send_timeout 900s;

        # 按服务器实际 PHP-FPM 版本修改。
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location ~ /\. {
        deny all;
    }
}
