APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8788
APP_BASE_PATH=
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yiyunying
DB_USER=root
DB_PASSWORD=

QR_SIGNING_KEY=replace-with-a-random-secret
# Required for protected forum media: use a distinct random value of at least 32 bytes.
MEDIA_SIGNING_KEY=
MAIL_TRANSPORT=native
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=易运盈后台

AI_ENABLED=true
AI_PROVIDER=ollama
AI_API_URL=http://127.0.0.1:11434
AI_API_KEY=
AI_MODEL=qwen2.5:3b

STT_PROVIDER=local-command
STT_API_URL=
STT_API_KEY=
STT_MODEL=base

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NEWS_TOP_RSS_URL=https://news.google.com/rss
NEWS_SEARCH_RSS_URL=https://news.google.com/rss/search

# JSON array. Production calls should include a TURN service.
VOICE_CALL_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
VOICE_CALL_RING_TIMEOUT_SECONDS=60
VOICE_CALL_ACTIVE_TIMEOUT_SECONDS=45
VOICE_CALL_SIGNAL_POLL_MS=100
