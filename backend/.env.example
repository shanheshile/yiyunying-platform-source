APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8788
APP_BASE_PATH=
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yiyunying
DB_USER=root
DB_PASSWORD=

QR_SIGNING_KEY=replace-with-a-random-secret
# Required for protected forum media: use a distinct random value of at least 32 bytes.
MEDIA_SIGNING_KEY=
# Comma-separated exact IPv4/IPv6 addresses or CIDRs of reverse proxies that overwrite X-Forwarded-For.
# Empty by default: direct clients cannot spoof their source IP through X-Forwarded-For.
TRUSTED_PROXIES=
# disabled | smtp | native | log. Production should normally use smtp.
MAIL_TRANSPORT=disabled
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=易运盈后台
# 64 位小写十六进制（32 随机字节）；必须由服务器秘密管理注入且跨重启保持稳定。
MAIL_SETTINGS_MASTER_KEY=
MAIL_SETTINGS_ACTIVE_KEY_ID=v1
# 轮换时先把旧、新密钥都放入 JSON 密钥环，再切换 ACTIVE ID；确认密文重写后才能撤旧键。
MAIL_SETTINGS_KEYRING_JSON=
# true 时总控端已保存的安全 DB 配置优先；仅当 DB 尚无配置行时回退到下方 MAIL_*。
MAIL_DATABASE_CONFIG_ENABLED=true
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TIMEOUT=10
MAIL_SMTP_HELO=

AI_ENABLED=true
AI_PROVIDER=ollama
AI_API_URL=http://127.0.0.1:11434
AI_API_KEY=
AI_MODEL=qwen2.5:3b

STT_PROVIDER=local-command
STT_API_URL=
STT_API_KEY=
STT_MODEL=base

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NEWS_TOP_RSS_URL=https://news.google.com/rss
NEWS_SEARCH_RSS_URL=https://news.google.com/rss/search

# JSON array. Production calls should include a TURN service.
VOICE_CALL_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
VOICE_CALL_RING_TIMEOUT_SECONDS=60
VOICE_CALL_ACTIVE_TIMEOUT_SECONDS=45
VOICE_CALL_SIGNAL_POLL_MS=100
